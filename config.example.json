      "type": "slack",
      "secret": "SLACK_TOKEN_EXAMPLE",
      "channels": [
        { "id": "C0123456789", "feeds": ["linear-example", "crm-example"] },
        { "id": "D0123456789", "feeds": ["crm-example"], "private": true }
      ]
    },
    {
      "id": "forum-example",
      "type": "discourse",
      "reader": "readers/discourse.py",
