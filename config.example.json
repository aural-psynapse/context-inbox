    },
    {
      "id": "mail-example",
      "type": "gmail",
      "how": "Gmail connector. One channel per label id. Cursor is the newest message date read.",
      "channels": [ { "id": "Label_123", "feeds": ["crm-example"] } ]
    }
  ],
  "destinations": [
    { "id": "linear-example", "type": "linear", "team": "ABC" },
    { "id": "crm-example", "type": "attio", "workspace": "example" },
    { "id": "docs-example", "type": "github", "repo": "org/repo", "branch": "main" },
